[Unit]
Description=afframe health

[Timer]
# A run with backups on lists the backup repository: a shorter interval adds storage requests.
# The health limit in $INTERNAL/kits/afframe-heartbeat/worker.js must stay above this interval.
OnCalendar=*-*-* 00,06,12,18:00:00 UTC
Persistent=true
Unit=afframe@health.service

[Install]
WantedBy=timers.target
