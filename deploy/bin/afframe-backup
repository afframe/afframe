#!/usr/bin/env bash
# pgBackRest backup of afframe-postgres to the repository configured in Vault (Cloudflare R2).
# Usage: afframe-backup [full|diff]   (default: full on Sundays, diff otherwise)
# Runs daily from afframe-backup.timer; reports to the BETTERSTACK_BACKUP_HEARTBEAT URL.
set -euo pipefail
# shellcheck source=deploy/bin/common.sh
source "$(dirname "$0")/common.sh"

type="${1:-}"
if [[ -z "$type" ]]; then
  type="diff"
  [[ "$(date -u +%u)" == 7 ]] && type="full"
fi
[[ "$type" == full || "$type" == diff ]] || die "usage: afframe-backup [full|diff]"

# Before the backup, so the backup carries a fresh sentinel for afframe-restore-drill.
write_sentinel
code=0
output="$(docker exec -u postgres afframe-postgres pgbackrest --type="$type" backup 2>&1)" || code=$?
echo "$output"
heartbeat BETTERSTACK_BACKUP_HEARTBEAT "$code" "$(tail -n 20 <<< "$output")"
exit "$code"
