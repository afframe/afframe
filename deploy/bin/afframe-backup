#!/usr/bin/env bash
# Usage: afframe-backup [full|diff]   (default: full on Sundays, diff otherwise)
set -euo pipefail
# shellcheck source=deploy/bin/common.sh
source "$(dirname "$0")/common.sh"
refuse_root
docker_config

type="${1:-}"
if [[ -z "$type" ]]; then
  type="diff"
  [[ "$(date -u +%u)" == 7 ]] && type="full"
fi
[[ "$type" == full || "$type" == diff ]] || die "usage: afframe-backup [full|diff]"

# Before the backup, so the backup carries a fresh sentinel for afframe-restore-drill. Only warns.
log "heartbeat sentinel"
psql_exec "$POSTGRES" -q -v ON_ERROR_STOP=1 -c "
  set client_min_messages = warning;
  create schema if not exists ops;
  create table if not exists ops.heartbeat (id int primary key, at timestamptz not null);
  insert into ops.heartbeat values (1, now()) on conflict (id) do update set at = excluded.at" \
  || echo "warning: ops.heartbeat sentinel not written; the restore drill will report stale data" >&2
code=0
output="$(docker exec -u postgres "$POSTGRES" pgbackrest --type="$type" backup 2>&1)" || code=$?
echo "$output"
heartbeat HEARTBEAT_BACKUP_URL "$code" "$(tail -n 20 <<< "$output")"
exit "$code"
