#!/usr/bin/env bash
# Usage: afframe-backup [full|diff]   (default: full on Sundays, diff otherwise)
set -euo pipefail
# shellcheck source=deploy/bin/common.sh
source "$(dirname "$0")/common.sh"
refuse_root

type="${1:-}"
if [[ -z "$type" ]]; then
  type="diff"
  [[ "$(date -u +%u)" == 7 ]] && type="full"
fi
[[ "$type" == full || "$type" == diff ]] || die "usage: afframe-backup [full|diff]"

# Before the backup, so the backup carries a fresh sentinel for afframe-restore-drill.
write_sentinel
code=0
output="$(docker exec -u postgres "$POSTGRES" pgbackrest --type="$type" backup 2>&1)" || code=$?
echo "$output"
heartbeat HEARTBEAT_BACKUP_URL "$code" "$(tail -n 20 <<< "$output")"
exit "$code"
