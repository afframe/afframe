#!/usr/bin/env bash
# Inputs VAULT_ADDR, AFFRAME_VAULT_KV_PREFIX, VAULT_TOKEN: environment or AFFRAME_HOME files
set -euo pipefail
# shellcheck source=deploy/bin/common.sh
source "$(dirname "$0")/common.sh"

vault_credential
: "${VAULT_ADDR:?VAULT_ADDR is not set}" "${AFFRAME_VAULT_KV_PREFIX:?AFFRAME_VAULT_KV_PREFIX is not set}" \
  "${VAULT_TOKEN:?VAULT_TOKEN is not set}"
# Traefik runs as root in its container: the files stay unreadable for other host users.
umask 077
mkdir -p "$AFFRAME_HOME/env" "$AFFRAME_HOME/tls"

# The token goes to curl on stdin (-H @-), never on its command line, where `ps` would show it.
read_kv() {
  curl -fsS -m 10 -H @- "$VAULT_ADDR/v1/$AFFRAME_VAULT_KV_PREFIX/$1" <<< "X-Vault-Token: $VAULT_TOKEN" \
    | jq -e '.data.data'
}

# write_env <json> <file>: KEY=VALUE lines for every key except *_PEM; refuses multi-line values.
write_env() {
  jq -r 'to_entries[] | select(.key | endswith("_PEM") | not)
    | if (.value | tostring | contains("\n")) then error("multi-line value for \(.key)")
      else "\(.key)=\(.value)" end' <<< "$1" > "$2.tmp"
  mv "$2.tmp" "$2"
}

infra="$(read_kv infra)" || die "cannot read the infra secret"
app="$(read_kv app)" || die "cannot read the app secret"
jq -e '.APP_DB_PASSWORD | strings | length > 0' <<< "$infra" > /dev/null || die "APP_DB_PASSWORD missing in infra"
db="$(sed -n 's/.*[[:space:]]POSTGRES_DB=\([^[:space:]]*\).*/\1/p' "$REPO/deploy/postgres/Dockerfile")"
[[ -n "$db" ]] || die "no POSTGRES_DB in deploy/postgres/Dockerfile"
! jq -e 'has("DATABASE_URL")' <<< "$app" > /dev/null \
  || die "DATABASE_URL in the app secret is not allowed; vault-env derives it"
# Both secrets go to jq on stdin, never on its command line, where `ps` would show them.
app="$(printf '%s\n%s\n' "$infra" "$app" | jq -s --arg role "$APP_ROLE" --arg host "$POSTGRES" --arg db "$db" \
  '.[1] + {DATABASE_URL: "postgres://\($role):\(.[0].APP_DB_PASSWORD | @uri)@\($host):5432/\($db)"}')"

write_env "$infra" "$AFFRAME_HOME/env/infra.env"
write_env "$app" "$AFFRAME_HOME/env/app.env"
# The tls/origin.* paths pair with deploy/traefik/dynamic/tls.yml.
jq -er '.ORIGIN_CERT_PEM' <<< "$infra" > "$AFFRAME_HOME/tls/origin.crt.tmp" || die "ORIGIN_CERT_PEM missing in infra"
jq -er '.ORIGIN_KEY_PEM' <<< "$infra" > "$AFFRAME_HOME/tls/origin.key.tmp" || die "ORIGIN_KEY_PEM missing in infra"
mv "$AFFRAME_HOME/tls/origin.crt.tmp" "$AFFRAME_HOME/tls/origin.crt"
mv "$AFFRAME_HOME/tls/origin.key.tmp" "$AFFRAME_HOME/tls/origin.key"
echo "secrets rendered: $(wc -l < "$AFFRAME_HOME/env/infra.env") infra, $(wc -l < "$AFFRAME_HOME/env/app.env") app"
