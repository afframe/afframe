#!/usr/bin/env bash
# Restore drill, monthly from afframe-restore-drill.timer. Restores the latest pgBackRest backup
# (with WAL to the end of the archive) into a throwaway container from the production image and
# waits until it is promoted; then restores the latest nightly dump (with its roles) into a second
# throwaway container. Both must hold an ops.heartbeat sentinel (written by afframe-dump and
# afframe-backup) younger than RPO_HOURS: recent data came back, not just a database that starts.
# Nothing touches production. Reports to the BETTERSTACK_DRILL_HEARTBEAT URL.
set -euo pipefail
# shellcheck source=deploy/bin/common.sh
source "$(dirname "$0")/common.sh"

name=afframe-restore-drill
dump_name=afframe-restore-drill-dump
# Recovery point target: the sentinel is upserted nightly, so a healthy restore is under a day old.
RPO_HOURS=26
work="$(mktemp -d)"
pgbackrest_env=(
  --env-file "$AFFRAME_HOME/env/infra.env"
  -e PGBACKREST_STANZA=afframe
  -e PGBACKREST_PG1_PATH=/var/lib/postgresql/18/docker
  -e PGBACKREST_PG1_USER=afframe
  -e PGBACKREST_LOG_PATH=/tmp
  -e PGBACKREST_LOCK_PATH=/tmp/pgbackrest
  -v afframe-pgbackrest:/var/lib/pgbackrest:ro
  -v "$name:/var/lib/postgresql"
)

cleanup() {
  docker rm -f -v "$name" "$dump_name" > /dev/null 2>&1 || true
  docker volume rm "$name" > /dev/null 2>&1 || true
}

rclone() {
  docker run --rm --env-file "$work/rclone.env" -v "$AFFRAME_HOME/dumps:/backup" \
    "$RCLONE_IMAGE" --quiet "$@"
}

# sentinel <container> <what>: fails unless the restored ops.heartbeat is younger than RPO_HOURS.
sentinel() {
  local age
  age="$(docker exec "$1" psql -U afframe -d afframe -v ON_ERROR_STOP=1 -Atc \
    "select extract(epoch from now() - max(at))::bigint from ops.heartbeat")" \
    || { echo "$2: no ops.heartbeat sentinel in the restored database" >&2; return 1; }
  [[ -n "$age" ]] || { echo "$2: ops.heartbeat is empty" >&2; return 1; }
  ((age <= RPO_HOURS * 3600)) || {
    echo "$2: newest data is $((age / 3600)) h old, over the $RPO_HOURS h recovery point target" >&2
    return 1
  }
  log "$2 ok: sentinel $((age / 60)) min old"
}

# dump_drill: restores the newest dump and its roles into a throwaway container without a network.
dump_drill() {
  local latest stamp i
  dump_rclone_env "$work/rclone.env" || return 1
  latest="$(rclone lsf --include 'afframe-*.dump' dumps: | sort | tail -n 1)" || return 1
  [[ -n "$latest" ]] || { echo "no dump found" >&2; return 1; }
  stamp="${latest#afframe-}"
  stamp="${stamp%.dump}"
  log "restore $latest into $dump_name"
  docker run -d --name "$dump_name" --network none -e POSTGRES_USER=afframe -e POSTGRES_DB=afframe \
    -e POSTGRES_HOST_AUTH_METHOD=trust afframe-postgres:local > /dev/null || return 1
  # The image's init runs a socket-only server first; TCP answers once the real server is up.
  for ((i = 1; i <= 60; i++)); do
    docker exec "$dump_name" pg_isready -q -h 127.0.0.1 -U afframe && break
    sleep 1
  done
  ((i <= 60)) || { docker logs --tail 50 "$dump_name" >&2; return 1; }
  # The roles script recreates the existing afframe role; that one error is expected.
  rclone cat "dumps:globals-$stamp.sql" | docker exec -i "$dump_name" psql -U afframe -d postgres -q \
    > /dev/null 2>&1 || return 1
  rclone cat "dumps:$latest" | docker exec -i "$dump_name" pg_restore -U afframe -d afframe --exit-on-error \
    || return 1
  sentinel "$dump_name" "dump restore" || return 1
}

drill() {
  cleanup
  log "restore into $name"
  # Called with `|| code=$?`, so errexit is off in here: every step returns on failure itself.
  docker run --rm "${pgbackrest_env[@]}" -u postgres afframe-postgres:local \
    sh -c 'mkdir -m 700 -p "$PGBACKREST_PG1_PATH" && pgbackrest restore' || return 1
  # archive_mode off: the drill must never push WAL into the production repository.
  docker run -d --name "$name" "${pgbackrest_env[@]}" afframe-postgres:local \
    postgres -c archive_mode=off > /dev/null || return 1

  log "wait for recovery to finish"
  local i
  for ((i = 1; i <= 300; i++)); do
    if [[ "$(docker exec "$name" psql -U afframe -d afframe -Atc 'select pg_is_in_recovery()' 2> /dev/null)" == f ]]; then
      break
    fi
    sleep 1
  done
  ((i <= 300)) || { docker logs --tail 50 "$name" >&2; return 1; }
  sentinel "$name" "pgBackRest restore" || return 1
  cleanup # one restored database on disk at a time
  dump_drill || return 1
}

trap 'cleanup; rm -rf "$work"' EXIT
code=0
output="$(drill 2>&1)" || code=$?
echo "$output"
heartbeat BETTERSTACK_DRILL_HEARTBEAT "$code" "$(tail -n 20 <<< "$output")"
exit "$code"
