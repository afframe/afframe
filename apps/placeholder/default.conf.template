server {
    listen ${PORT};
    listen [::]:${PORT};
    root /usr/share/nginx/html;

    server_tokens off;
    error_page 400 401 403 404 405 408 413 414 429 500 502 503 504 /error.html;

    location = /error.html {
        internal;
    }

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        index index.html;
    }
}
